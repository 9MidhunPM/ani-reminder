generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduleState {
  UNVERIFIED
  SCHEDULED
  WAITING
  COMPLETED
  CANCELLED
}

enum NotificationKind {
  MORNING
  AIRTIME
  TEST
}

enum DeliveryState {
  PENDING
  CLAIMED
  SENT
  FAILED
  UNCERTAIN
  SKIPPED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  ntfyTopic    String
  morningEnabled Boolean @default(true)
  airtimeEnabled Boolean @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reminders    AnimeReminder[]
  deliveries   NotificationDelivery[]
}

model SchedulerControl {
  id String @id @default("main")
  deliveryEnabled Boolean @default(false)
  cutoverAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  leaseOwner String?
  leaseUntil DateTime?
  nextProviderRequestAt DateTime?
  providerBackoffUntil DateTime?
  updatedAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @updatedAt
}

model NotificationDelivery {
  id String @id @default(cuid())
  userId String
  anilistId Int?
  episode Int?
  kind NotificationKind
  state DeliveryState @default(PENDING)
  title String
  airingAt DateTime?
  sourceId Int?
  scheduledFor DateTime
  claimedAt DateTime?
  sentAt DateTime?
  error String?
  receiptId String?
  attempts Int @default(0)
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)"))
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId, episode, kind])
  @@index([state, scheduledFor])
  @@index([userId, createdAt])
}

model AnimeReminder {
  id                 String   @id @default(cuid())
  userId             String
  anilistId          Int?
  malId              Int?
  title              String
  titleEnglish       String?
  imageUrl            String
  nextEpisode         Int?
  nextAiringAt        DateTime?
  nextAiringId        Int?
  mediaStatus        String?
  scheduleState      ScheduleState @default(UNVERIFIED)
  scheduleCheckedAt  DateTime?
  nextCheckAt        DateTime?
  syncError          String?
  broadcastDay        String?
  broadcastTime       String?
  broadcastTimezone   String?
  totalEpisodes       Int?
  enabled             Boolean  @default(true)
  morningNotifiedFor  DateTime?
  airtimeNotifiedFor  DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@unique([userId, malId])
  @@index([enabled, nextAiringAt])
  @@index([nextCheckAt])
}

model RateLimit {
  id              String    @id @default(cuid())
  key             String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}
