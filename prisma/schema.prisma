generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScheduleState {
  UNVERIFIED
  SCHEDULED
  WAITING
  COMPLETED
  CANCELLED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  ntfyTopic    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reminders    AnimeReminder[]
}

model AnimeReminder {
  id                 String   @id @default(cuid())
  userId             String
  anilistId          Int?
  malId              Int?
  title              String
  titleEnglish       String?
  imageUrl            String
  nextEpisode         Int?
  nextAiringAt        DateTime?
  nextAiringId        Int?
  mediaStatus        String?
  scheduleState      ScheduleState @default(UNVERIFIED)
  scheduleCheckedAt  DateTime?
  nextCheckAt        DateTime?
  syncError          String?
  broadcastDay        String?
  broadcastTime       String?
  broadcastTimezone   String?
  totalEpisodes       Int?
  enabled             Boolean  @default(true)
  morningNotifiedFor  DateTime?
  airtimeNotifiedFor  DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@unique([userId, malId])
  @@index([enabled, nextAiringAt])
  @@index([nextCheckAt])
}

model RateLimit {
  id              String    @id @default(cuid())
  key             String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}
